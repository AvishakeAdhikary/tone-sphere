{
  "name": "nextone",
  "productName": "NexTone",
  "version": "0.1.0",
  "description": "NexTone — simple, powerful audio routing for everyone",
  "license": "GPL-3.0-or-later",
  "author": "NexTone contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock-engine": "node mock-engine/server.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:store": "npm run build && electron-builder --config electron-builder.store.json --win appx",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {},
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@playwright/test": "^1.54.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.7.0": true
  },
  "build": {
    "appId": "com.nextone.app",
    "productName": "NexTone",
    "copyright": "NexTone contributors (GPL-3.0-or-later)",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "to": "LICENSE.txt",
        "from": "../LICENSE"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "executableName": "NexTone",
      "extraResources": [
        {
          "to": "engine/nextone-engine.exe",
          "from": "../build/x64-release/bin/nextone-engine.exe"
        },
        {
          "to": "engine/nextone-plugscan.exe",
          "from": "../build/x64-release/bin/nextone-plugscan.exe"
        },
        {
          "to": "drivers/NexToneASIO64.dll",
          "from": "../build/x64-release/bin/NexToneASIO64.dll"
        },
        {
          "to": "drivers/NexToneASIO32.dll",
          "from": "../build/x86-release/bin/NexToneASIO32.dll"
        },
        {
          "to": "drivers/nextone-setup.exe",
          "from": "../build/x64-release/bin/nextone-setup.exe"
        },
        {
          "from": "../drivers/win/vad/build/package",
          "to": "drivers/vad",
          "filter": [
            "nextonevad.*",
            "NexToneTest.cer"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "license": "../LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "NexTone-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "NexTone",
      "identityName": "NexTone.NexTone",
      "publisher": "CN=NexTone Dev",
      "publisherDisplayName": "NexTone",
      "displayName": "NexTone",
      "backgroundColor": "transparent",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ],
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "NexTone-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Audio",
      "executableName": "nextone",
      "synopsis": "Route any audio anywhere",
      "extraResources": [
        {
          "from": "../build/linux-release/bin/nextone-engine",
          "to": "engine/nextone-engine"
        },
        {
          "from": "../build/linux-release/bin/nextone-plugscan",
          "to": "engine/nextone-plugscan"
        }
      ]
    },
    "appImage": {
      "artifactName": "NexTone-${version}-${arch}.${ext}"
    }
  }
}
