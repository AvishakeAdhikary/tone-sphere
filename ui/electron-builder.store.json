{
  "extends": null,
  "appId": "com.neuralnexusstudios.tonesphere",
  "productName": "ToneSphere",
  "directories": { "output": "release-store", "buildResources": "build" },
  "files": ["dist/**", "dist-electron/**", "assets/**", "package.json"],
  "extraResources": [
    { "from": "../build/x64-release/bin/tonesphere-engine.exe", "to": "engine/tonesphere-engine.exe" },
    { "from": "../build/x64-release/bin/tonesphere-plugscan.exe", "to": "engine/tonesphere-plugscan.exe" },
    { "from": "../LICENSE", "to": "LICENSE.txt" }
  ],
  "win": { "icon": "assets/icon.ico", "target": ["appx"], "executableName": "ToneSphere" },
  "appx": {
    "applicationId": "ToneSphere",
    "identityName": "NeuralNexusStudios.ToneSphere",
    "publisher": "CN=Neural Nexus Studios",
    "publisherDisplayName": "ToneSphere",
    "displayName": "ToneSphere",
    "backgroundColor": "transparent",
    "showNameOnTiles": false,
    "languages": ["en-US"],
    "customExtensionsPath": "build/appx-extensions.xml",
    "customManifestPath": "build/appxmanifest.xml",
    "minVersion": "10.0.19041.0",
    "maxVersionTested": "10.0.26100.0",
    "artifactName": "ToneSphere-${version}.${ext}"
  }
}
