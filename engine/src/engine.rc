#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TONESPHERE_VERSION_MAJOR,TONESPHERE_VERSION_MINOR,TONESPHERE_VERSION_PATCH,0
 PRODUCTVERSION TONESPHERE_VERSION_MAJOR,TONESPHERE_VERSION_MINOR,TONESPHERE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Neural Nexus Studios"
            VALUE "FileDescription", "ToneSphere Audio Engine"
            VALUE "FileVersion", TONESPHERE_VERSION
            VALUE "InternalName", "tonesphere-engine"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "tonesphere-engine.exe"
            VALUE "ProductName", "ToneSphere"
            VALUE "ProductVersion", TONESPHERE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
